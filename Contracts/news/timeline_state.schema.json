{
  "$defs": {
    "ImportanceAssessment": {
      "description": "분야와 무관하게 같은 배점으로 계산한 사건 중요도.",
      "properties": {
        "change_magnitude": {
          "maximum": 25,
          "minimum": 0,
          "title": "Change Magnitude",
          "type": "integer"
        },
        "impact_scope": {
          "maximum": 25,
          "minimum": 0,
          "title": "Impact Scope",
          "type": "integer"
        },
        "durability": {
          "maximum": 20,
          "minimum": 0,
          "title": "Durability",
          "type": "integer"
        },
        "trajectory_power": {
          "maximum": 20,
          "minimum": 0,
          "title": "Trajectory Power",
          "type": "integer"
        },
        "evidence_strength": {
          "maximum": 10,
          "minimum": 0,
          "title": "Evidence Strength",
          "type": "integer"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "change_magnitude",
        "impact_scope",
        "durability",
        "trajectory_power",
        "evidence_strength"
      ],
      "title": "ImportanceAssessment",
      "type": "object"
    },
    "TimelineEvent": {
      "description": "타임라인의 한 시점에서 일어난 사건 1건.\n\n시점의 단위는 «리포트 날짜» 다. 기사 발행 시각(`published_at`)이 아닌 이유는\n커넥터마다 채우는 형식이 다르고(RFC-822 / ISO-8601) linkedin 은 아예 안 채우기\n때문이다. 리포트 날짜는 파일명에 항상 있고 모호하지 않다.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "date": {
          "title": "Date",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        },
        "importance": {
          "default": 0,
          "title": "Importance",
          "type": "integer"
        },
        "importance_assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImportanceAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bullets": {
          "items": {
            "type": "string"
          },
          "title": "Bullets",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "why_it_matters": {
          "default": "",
          "title": "Why It Matters",
          "type": "string"
        },
        "turning_point_reason": {
          "default": "",
          "title": "Turning Point Reason",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "date",
        "title"
      ],
      "title": "TimelineEvent",
      "type": "object"
    },
    "TimelineMonth": {
      "description": "월 버킷 하나. 재계산 여부를 스스로 판단할 근거를 들고 있다.",
      "properties": {
        "month_key": {
          "title": "Month Key",
          "type": "string"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "synthesized_at": {
          "default": "",
          "title": "Synthesized At",
          "type": "string"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "prompt_version": {
          "default": 0,
          "title": "Prompt Version",
          "type": "integer"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "key_terms": {
          "items": {
            "type": "string"
          },
          "title": "Key Terms",
          "type": "array"
        },
        "axis_events": {
          "items": {
            "$ref": "#/$defs/TimelineEvent"
          },
          "title": "Axis Events",
          "type": "array"
        },
        "detail_events": {
          "items": {
            "$ref": "#/$defs/TimelineEvent"
          },
          "title": "Detail Events",
          "type": "array"
        }
      },
      "required": [
        "month_key",
        "input_hash"
      ],
      "title": "TimelineMonth",
      "type": "object"
    },
    "TimelineOverview": {
      "description": "타임라인 전체 머리말. 원본 사건이 아니라 월 요약들만 보고 만든다.",
      "properties": {
        "input_hash": {
          "default": "",
          "title": "Input Hash",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "emphasis_keywords": {
          "items": {
            "type": "string"
          },
          "title": "Emphasis Keywords",
          "type": "array"
        }
      },
      "title": "TimelineOverview",
      "type": "object"
    }
  },
  "description": "`data/timeline/<category_id>.json` 의 전체 모양. 모든 렌더링의 단일 진실 공급원.",
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "category_id": {
      "title": "Category Id",
      "type": "string"
    },
    "category_label": {
      "title": "Category Label",
      "type": "string"
    },
    "axis_limit": {
      "default": 3,
      "maximum": 5,
      "minimum": 1,
      "title": "Axis Limit",
      "type": "integer"
    },
    "date_from": {
      "default": "",
      "title": "Date From",
      "type": "string"
    },
    "date_to": {
      "default": "",
      "title": "Date To",
      "type": "string"
    },
    "generated_at": {
      "default": "",
      "title": "Generated At",
      "type": "string"
    },
    "months": {
      "items": {
        "$ref": "#/$defs/TimelineMonth"
      },
      "title": "Months",
      "type": "array"
    },
    "overview": {
      "$ref": "#/$defs/TimelineOverview"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "category_id",
    "category_label"
  ],
  "title": "TimelineState",
  "type": "object"
}
